# sync_to_nas.py 配置文件
# 复制此文件为 .env 并填入实际值：
#   cp .env.example .env

# NAS 面板地址
# 公网（通过 Cloudflare Tunnel）：https://panel.darewin.icu
# 内网（局域网直连，更快）：http://192.168.5.8:8000
PANEL_HOST=https://panel.darewin.icu

# 数据同步令牌（必须与 NAS docker-compose.yml 中 panel 服务的 DEPLOY_TOKEN 一致）
# 生成一个随机字符串，如：python -c "import secrets; print(secrets.token_urlsafe(32))"
DEPLOY_TOKEN=请替换为你的密钥
